{
  "name": "statuscasa-blog",
  "main": "src/index.ts",
  "compatibility_date": "2024-11-01",
  "compatibility_flags": ["nodejs_compat", "nodejs_als"],
  "dev": {
    "port": 9015,
    "local_protocol": "http"
  },
  "d1_databases": [
    {
      "binding": "BLOG_DB",
      "database_name": "statuscasa-blog-db",
      "database_id": "a05049af-9272-4372-92d3-b65763079b8e"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "BLOG_KV",
      "id": "783b90edd2cd4c12b92cf97aea326936"
    }
  ],
  "vars": {
    "JWT_SECRET": "placeholder-jwt-secret-change-in-production",
    "SERVICE_TOKEN_SECRET": "placeholder-service-token-secret"
  }
}
